# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env в репозиторий.

# Данные приложения Telegram (https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Имя (или путь) файла сессии Telethon, без расширения .session.
# Файл хранится локально, не коммитится.
# При запуске в Docker укажите путь внутрь смонтированного volume ./data,
# чтобы сессия переживала пересоздание контейнера:
#   TELEGRAM_SESSION_NAME=data/news_aggregator
TELEGRAM_SESSION_NAME=news_aggregator

# Если публикуем в Telegram-канал — его username или id (например @my_channel)
TELEGRAM_TARGET_CHANNEL=

# --- Бот управления каналами (необязательно) ---
# Если оба значения ниже заданы, при запуске без --once поднимается ещё и
# Telegram-бот (Bot API, НЕ Telethon), который понимает команды /list,
# /add, /remove, /pause, /resume для управления списком каналов без правки
# config.yaml и без перезапуска. Если не заданы — бот просто не стартует,
# остальной функционал не меняется.

# Токен от @BotFather (создайте нового бота командой /newbot)
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram user id (НЕ username) — бот отвечает только вам,
# остальным пользователям — отказ. Узнать свой id можно, написав боту
# @userinfobot.
TELEGRAM_BOT_OWNER_ID=
